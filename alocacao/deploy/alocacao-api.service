[Unit]
Description=Versal Alocação de Recursos API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=alocacao
Group=alocacao
WorkingDirectory=/alocacao/backend
EnvironmentFile=/alocacao/backend/.env
ExecStart=/alocacao/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8001 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/alocacao/backend/data

[Install]
WantedBy=multi-user.target
