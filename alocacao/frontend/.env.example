# Azure AD / Microsoft Entra ID (obrigatório em produção)
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=common
VITE_AZURE_REDIRECT_URI=http://localhost:5174

# Permite sessão local de desenvolvimento quando o Azure não está configurado
VITE_ALLOW_DEV_LOGIN=true

# API backend
VITE_API_URL=http://localhost:8001
